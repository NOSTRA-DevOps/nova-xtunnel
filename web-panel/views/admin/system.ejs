<%- include('../partials/head', { title: t('system.title') + ' — NOVA X Tunnel' }) %>
<div class="shell">
  <%- include('../partials/sidebar', { role: 'admin' }) %>

  <div class="main">
    <div class="topbar">
      <div>
        <h1 class="page-title"><%= t('system.title') %></h1>
        <p class="page-sub"><%= t('system.subtitle') %></p>
      </div>
    </div>

    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <% if (success) { %><div class="alert success"><%= success %></div><% } %>

    <!-- ---- Server info ---- -->
    <div class="panel">
      <div class="panel-head">
        <h2><%= t('system.info_title') %></h2>
      </div>
      <div class="stat-grid">
        <div class="stat-card">
          <div class="stat-label"><%= t('system.info.os') %></div>
          <div class="stat-value" style="font-size:15px;"><%= osName %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label"><%= t('system.info.ip') %></div>
          <div class="stat-value mono" style="font-size:15px;"><%= serverIp %></div>
        </div>
        <div class="stat-card">
          <div class="stat-label"><%= t('system.info.uptime') %></div>
          <div class="stat-value" style="font-size:15px;"><%= uptime %></div>
        </div>
      </div>
    </div>

    <!-- ---- Traffic Monitor ---- -->
    <div class="panel">
      <div class="panel-head">
        <h2><%= t('system.traffic_title') %></h2>
      </div>
      <% if (!iface) { %>
        <p class="muted"><%= t('system.traffic.no_interface') %></p>
      <% } else { %>
        <p class="muted" style="margin-bottom:14px;"><%= t('system.traffic.interface') %>: <span class="mono"><%= iface %></span></p>
        <div class="stat-grid" style="margin-bottom:10px;">
          <div class="stat-card">
            <div class="stat-label">⬇️ <%= t('system.traffic.download') %></div>
            <div class="stat-value" id="traffic-rx-rate">—</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">⬆️ <%= t('system.traffic.upload') %></div>
            <div class="stat-value" id="traffic-tx-rate">—</div>
          </div>
          <div class="stat-card">
            <div class="stat-label"><%= t('system.traffic.total_since_boot') %></div>
            <div class="stat-value" style="font-size:14px;" id="traffic-totals">
              ⬇️ <%= totals.rx != null ? (Math.round(totals.rx / 1024 / 1024)) + ' MB' : '—' %>
              &nbsp;/&nbsp;
              ⬆️ <%= totals.tx != null ? (Math.round(totals.tx / 1024 / 1024)) + ' MB' : '—' %>
            </div>
          </div>
        </div>
        <% if (!vnstatInstalled) { %>
          <p class="muted"><%= t('system.traffic.vnstat_hint') %></p>
        <% } %>
      <% } %>
    </div>

    <!-- ---- Block Torrent ---- -->
    <div class="panel">
      <div class="panel-head">
        <h2><%= t('system.torrent_title') %></h2>
      </div>
      <p class="muted" style="margin-bottom:14px;"><%= t('system.torrent.description') %></p>
      <div style="display:flex; align-items:center; gap:14px;">
        <span class="pill <%= torrentBlockEnabled ? 'active' : 'deleted' %>">
          <%= torrentBlockEnabled ? t('system.torrent.enabled') : t('system.torrent.disabled') %>
        </span>
        <form method="POST" action="/admin/system/torrent-block">
          <input type="hidden" name="enabled" value="<%= torrentBlockEnabled ? '0' : '1' %>">
          <button type="submit" class="btn small <%= torrentBlockEnabled ? 'danger' : '' %>">
            <%= torrentBlockEnabled ? t('system.torrent.disable') : t('system.torrent.enable') %>
          </button>
        </form>
      </div>
    </div>

    <!-- ---- Protocols (read-only status) ---- -->
    <div class="panel">
      <div class="panel-head">
        <h2><%= t('system.protocols_title') %></h2>
      </div>
      <p class="muted" style="margin-bottom:14px;"><%= t('system.protocols.description') %></p>
      <div class="protocol-grid">
        <% protocols.forEach((p) => { %>
          <div class="protocol-card">
            <div class="protocol-card-name"><%= p.label %></div>
            <div class="protocol-card-status <%= p.active ? 'active' : 'inactive' %>">
              <%= p.active ? t('system.protocols.active') : t('system.protocols.inactive') %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>

<script>
  // Live traffic rate, polled every 2s
  (function () {
    var rxEl = document.getElementById('traffic-rx-rate');
    var txEl = document.getElementById('traffic-tx-rate');
    var totalsEl = document.getElementById('traffic-totals');
    if (!rxEl) return;

    function fmtRate(bps) {
      var kbps = bps / 1024;
      if (kbps >= 1024) return (kbps / 1024).toFixed(2) + ' MB/s';
      return Math.round(kbps) + ' KB/s';
    }

    function poll() {
      fetch('/admin/system/traffic').then(function (r) { return r.json(); }).then(function (data) {
        if (!data || data.error || !data.rate) return;
        rxEl.textContent = fmtRate(data.rate.rxBps);
        txEl.textContent = fmtRate(data.rate.txBps);
        if (totalsEl && data.totals) {
          totalsEl.innerHTML = '⬇️ ' + Math.round(data.totals.rx / 1024 / 1024) + ' MB &nbsp;/&nbsp; ⬆️ ' + Math.round(data.totals.tx / 1024 / 1024) + ' MB';
        }
      }).catch(function () {});
    }
    poll();
    setInterval(poll, 2000);
  })();
</script>
</body>
</html>
