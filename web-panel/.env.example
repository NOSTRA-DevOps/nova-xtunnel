#.env file is optional you can use it to override the default values in config.js. The panel will use the values in this file if it exists, otherwise it will use the defaults in config.js.
# Copy this file to .env and edit the values before starting the panel.

PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-string

# Only used the very first time the panel starts (creates the initial admin account).
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=ChangeMe123!

# Your domain (used for reference in logs / links, and for secure-cookie decisions)
DOMAIN=panel.example.com

# Public port Nginx listens on (informational, used in links shown to the user)
PUBLIC_PORT=2045

# Set to "true" when the panel runs behind Nginx/TLS (deploy/install.sh sets this
# automatically). Enables secure session cookies and correct client-IP detection.
BEHIND_TLS_PROXY=false
